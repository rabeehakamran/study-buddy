# Copy this file to ".env" and fill in the values.

# Supabase dashboard -> Project Settings -> API (or "Connect")
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key

# Groq (free): https://console.groq.com/keys
# NO "VITE_" prefix on purpose: this key must never be sent to the browser.
GROQ_API_KEY=your-groq-key
# Optional: override the model (default openai/gpt-oss-120b, falls back to openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional limits (defaults shown). "Today" for limits uses APP_TIMEZONE, not the student's browser.
# CHAT_DAILY_LIMIT=5          # Ask Buddy messages per student per day
# QUIZ_DAILY_LIMIT=10         # quizzes per student per day
# GLOBAL_DAILY_CHATS=400      # all students together (protects the free Groq quota)
# GLOBAL_DAILY_QUIZZES=150
# APP_TIMEZONE=Asia/Karachi
